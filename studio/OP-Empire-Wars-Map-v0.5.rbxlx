      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">GardenAmbience</string>
          <string name="Source"><![CDATA[-- Local petal pool and waterfall spray; no gameplay or network state.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local settings = UserSettings():GetService("UserGameSettings")
local player = Players.LocalPlayer
local map = Workspace:WaitForChild("Archipelago")
local sources, sprays, petals = {}, {}, {}
local time, elapsed = 0, 0
local rng = Random.new(6445)
local folder = Instance.new("Folder")
folder.Name = "LocalGardenAmbience"
folder.Parent = Workspace

local function budget()
    local level = settings.SavedQualityLevel.Value
    if level > 0 and level <= 3 then return 0 end
    return level == 0 and 4 or 8
end

local function register(item)
    if not item:IsA("BasePart") then return end
    if item.Name == "ArtPetalSource" then
        sources[item] = true
    elseif item.Name == "ArtWaterfallMist" and not sprays[item] then
        local spray = Instance.new("ParticleEmitter")
        spray.Name = "LocalWaterfallSpray"
        spray.Texture = "rbxasset://textures/particles/smoke_main.dds"
        spray.Rate = budget() > 0 and 3 or 0
        spray.Lifetime = NumberRange.new(0.8, 1.2)
        spray.Speed = NumberRange.new(1, 3)
        spray.EmissionDirection = Enum.NormalId.Top
        spray.SpreadAngle = Vector2.new(50, 50)
        spray.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7)})
        spray.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1)})
        spray.Color = ColorSequence.new(Color3.fromRGB(179, 225, 234))
        spray.LightInfluence = 0.3
        spray.Parent = item
        sprays[item] = spray
    end
end
for _, item in ipairs(map:GetDescendants()) do register(item) end
local added = map.DescendantAdded:Connect(register)
local removing = map.DescendantRemoving:Connect(function(item)
    sources[item] = nil
    local spray = sprays[item]
    if spray then spray:Destroy(); sprays[item] = nil end
end)

for i = 1, 8 do
    local petal = Instance.new("Part")
    petal.Name = "DriftingPetal"
    petal.Shape = Enum.PartType.Ball
    petal.Size = Vector3.new(0.9, 0.1, 0.4)
    petal.Material = Enum.Material.SmoothPlastic
    petal.Color = Color3.fromRGB(230, 151 + i * 3, 181 + i * 2)
    petal.Anchored = true
    petal.CanCollide = false
    petal.CanTouch = false
    petal.CanQuery = false
    petal.CastShadow = false
    petal.Transparency = 1
    petal.Parent = folder
    table.insert(petals, { Part = petal, Seed = rng:NextNumber(0, 100), Speed = rng:NextNumber(2.1, 3.4) })
end

local changed = settings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
    for _, spray in pairs(sprays) do
        spray.Rate = budget() > 0 and 3 or 0
        if budget() == 0 then spray:Clear() end
    end
end)

local heartbeat = RunService.Heartbeat:Connect(function(dt)
    elapsed = elapsed + dt
    if elapsed < 0.05 then return end
    time = time + elapsed
    elapsed = 0
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local nearest, distance = nil, 130
    if root then
        for source in pairs(sources) do
            if source.Parent then
                local delta = source.Position - root.Position
                local flat = Vector2.new(delta.X, delta.Z).Magnitude
                if flat < distance then nearest, distance = source, flat end
            end
        end
    end
    local count = root and budget() or 0
    for i, petal in ipairs(petals) do
        if nearest and i <= count then
            local source = nearest.Position
            local drop = math.max(8, source.Y - 10)
            local age = (time * petal.Speed + petal.Seed) % drop
            petal.Part.Transparency = 0.12
            petal.Part.CFrame = CFrame.new(source.X + math.sin(time * 0.3 + petal.Seed) * 15,
                source.Y - age, source.Z + math.cos(time * 0.23 + petal.Seed) * 14)
                * CFrame.Angles(math.sin(time + i) * 0.8, time * 0.4 + i, math.cos(time * 0.7 + i) * 0.7)
        else
            petal.Part.Transparency = 1
        end
    end
end)

script.Destroying:Connect(function()
    heartbeat:Disconnect()
    changed:Disconnect()
    added:Disconnect()
    removing:Disconnect()
    for _, spray in pairs(sprays) do spray:Destroy() end
    folder:Destroy()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">MaritimeWeather</string>
          <string name="Source"><![CDATA[-- Local visual treatment only. Never changes server gameplay or global weather.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local world = require(ReplicatedStorage:WaitForChild("WorldEnvironment"))
local atmosphere = Lighting:WaitForChild("HarborAtmosphere")
local player = Players.LocalPlayer

local landColor = Color3.new(0.75, 0.81, 0.84)
local seaColor = Color3.new(0.69, 0.77, 0.81)
local weight = 0
local elapsed = 0
local wasEmitting = false
local anchors = {}
local emitters = {}

local settings = UserSettings():GetService("UserGameSettings")
local quality = settings.SavedQualityLevel.Value
local lowQuality = quality > 0 and quality <= 3
local qualityConnection = settings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
    local level = settings.SavedQualityLevel.Value
    lowQuality = level > 0 and level <= 3
    if lowQuality then
        for _, emitter in ipairs(emitters) do
            emitter.Rate = 0
            emitter:Clear()
        end
    end
end)

for side = -1, 1, 2 do
    local anchor = Instance.new("Part")
    anchor.Name = "LocalSeaMist"
    anchor.Size = Vector3.new(1, 1, 1)
    anchor.Anchored = true
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.CastShadow = false
    anchor.Parent = Workspace

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "LowSeaMist"
    emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(6, 8)
    emitter.Speed = NumberRange.new(2, 4)
    emitter.Drag = 0.6
    emitter.EmissionDirection = Enum.NormalId.Top
    emitter.SpreadAngle = Vector2.new(70, 70)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 55),
        NumberSequenceKeypoint.new(0.6, 95),
        NumberSequenceKeypoint.new(1, 120),
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.35, 0.95),
        NumberSequenceKeypoint.new(0.7, 0.97),
        NumberSequenceKeypoint.new(1, 1),
    })
    emitter.Color = ColorSequence.new(Color3.fromRGB(178, 198, 206))
    emitter.LightEmission = 0
    emitter.LightInfluence = 0.2
    emitter.Rotation = NumberRange.new(-180, 180)
    emitter.RotSpeed = NumberRange.new(-3, 3)
    emitter.LockedToPart = false
    emitter.Parent = anchor
    table.insert(anchors, { Part = anchor, Side = side })
    table.insert(emitters, emitter)
end

local function resetMist()
    weight = 0
    atmosphere.Density = 0.29
    atmosphere.Haze = 1.9
    atmosphere.Offset = 0.05
    atmosphere.Color = landColor
    for _, emitter in ipairs(emitters) do
        emitter.Rate = 0
        emitter:Clear()
    end
    wasEmitting = false
end
local respawnConnection = player.CharacterAdded:Connect(resetMist)

local connection
connection = RunService.Heartbeat:Connect(function(dt)
    elapsed = elapsed + dt
    if elapsed < 0.1 then
        return
    end
    local step = math.min(elapsed, 0.5)
    elapsed = 0
    local camera = Workspace.CurrentCamera
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not camera or not root then
        resetMist()
        return
    end

    local target = world.SeaWeight(root.Position.X, root.Position.Z)
    weight = weight + (target - weight) * (1 - math.exp(-step / 1.8))
    atmosphere.Density = 0.29 + weight * 0.10
    atmosphere.Haze = 1.9 + weight * 1.1
    atmosphere.Offset = 0.05 - weight * 0.13
    atmosphere.Color = landColor:Lerp(seaColor, weight)

    local emitting = target > 0.08 and root.Position.Y < 70
    local forward = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
    if forward.Magnitude < 0.01 then
        forward = Vector3.new(0, 0, -1)
    else
        forward = forward.Unit
    end
    local right = Vector3.new(-forward.Z, 0, forward.X)
    for i, anchor in ipairs(anchors) do
        local pos = root.Position + forward * 100 + right * (anchor.Side * 70)
        anchor.Part.Position = Vector3.new(pos.X, 3, pos.Z)
        -- Avoid emitting wisps over another island when sailing close to it.
        local localSea = world.SeaWeight(pos.X, pos.Z)
        emitters[i].Rate = emitting and (lowQuality and 0 or 1.25 * weight * localSea) or 0
        if not emitting and wasEmitting then
            emitters[i]:Clear()
        end
    end
    wasEmitting = emitting
end)

script.Destroying:Connect(function()
    if connection then
        connection:Disconnect()
    end
    qualityConnection:Disconnect()
    respawnConnection:Disconnect()
    for _, anchor in ipairs(anchors) do
        anchor.Part:Destroy()
    end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
