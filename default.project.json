{
  "name": "OP Empire Wars",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": { "StreamingEnabled": true, "StreamingMinRadius": 128, "StreamingTargetRadius": 512 },
      "Terrain": {
        "$className": "Terrain",
        "$ignoreUnknownInstances": true,
        "MaritimeClouds": {
          "$className": "Clouds",
          "$properties": { "Cover": 0.55, "Density": 0.42, "Color": [0.76, 0.75, 0.82] }
        }
      },
      "Archipelago": { "$path": "assets/Archipelago.rbxmx" }
    },
    "ReplicatedStorage": { "WorldEnvironment": { "$path": "src/shared/WorldEnvironment.luau" } },
    "StarterPlayer": { "StarterPlayerScripts": { "MaritimeWeather": { "$path": "src/client/MaritimeWeather.client.luau" }, "GardenAmbience": { "$path": "src/client/GardenAmbience.client.luau" } } },
    "ServerScriptService": { "World": { "$path": "src/server" } },
    "Lighting": {
      "$properties": {
        "ClockTime": 16.2,
        "Brightness": 2.4,
        "Technology": "Future",
        "ExposureCompensation": 0.12,
        "EnvironmentDiffuseScale": 0.65,
        "EnvironmentSpecularScale": 0.45,
        "Ambient": [0.32, 0.34, 0.44],
        "OutdoorAmbient": [0.58, 0.58, 0.65],
        "GlobalShadows": true,
        "ShadowSoftness": 0.3
      },
      "MaritimeSky": {
        "$className": "Sky",
        "$properties": {
          "SkyboxBk": "rbxasset://textures/sky/sky512_bk.tex",
          "SkyboxDn": "rbxasset://textures/sky/sky512_dn.tex",
          "SkyboxFt": "rbxasset://textures/sky/sky512_ft.tex",
          "SkyboxLf": "rbxasset://textures/sky/sky512_lf.tex",
          "SkyboxRt": "rbxasset://textures/sky/sky512_rt.tex",
          "SkyboxUp": "rbxasset://textures/sky/sky512_up.tex",
          "CelestialBodiesShown": true, "SunAngularSize": 12, "MoonAngularSize": 9, "StarCount": 500
        }
      },
      "HarborAtmosphere": {
        "$className": "Atmosphere",
        "$properties": { "Density": 0.29, "Offset": 0.05, "Color": [0.75, 0.81, 0.84], "Decay": [0.4, 0.5, 0.57], "Haze": 1.9, "Glare": 0.06 }
      },
      "HarborGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": { "Brightness": 0.015, "Contrast": 0.06, "Saturation": 0.02, "TintColor": [1, 0.96, 0.97] }
      },
      "LanternBloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.18, "Size": 20, "Threshold": 1.25 }
      }
    }
  }
}
